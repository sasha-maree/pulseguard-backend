# Port for Express API server
PORT=5000

# PostgreSQL Database Connection String (e.g. from Neon.tech or Supabase)
DATABASE_URL="postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: Discord Webhook URL for outage and recovery alerts
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"